# Copy this file to `.env` and fill in your real hacomono login.
# `.env` is gitignored — your password never gets committed.

KOTO_EMAIL=you@example.com
KOTO_PASSWORD=your-hacomono-password

# Optional: override config.json values without editing it.
# KOTO_DATE=2026-07-18
# KOTO_COURT=Court 3
# KOTO_TIME=19:00
# DRY_RUN=true
# HEADLESS=false
